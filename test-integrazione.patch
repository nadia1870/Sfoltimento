@@ -0,0 +1,178 @@
+using OSM.PaymentOrder.Purge.Data;
+
+namespace OSM.PaymentOrder.Purge.Tests;
+
+/// <summary>Costruzione di dataset minimi ma con la topologia completa.</summary>
+public sealed class SeedBuilder(SqlExecutor sql)
+{
+    private static int _seq;
+
+    public async Task<Guid> AddOrderAsync(
+        string statusCode = "Executed",
+        DateTime? executionDate = null,
+        DateTime? creationDate = null,
+        int revisions = 0,
+        string detailTable = "BankTransfer",
+        bool standingOrder = false,
+        DateTime? lastExecutionDate = null,
+        int relationshipNumber = 0)
+    {
+        var id = Guid.NewGuid();
+        var exec = executionDate ?? DateTime.Today.AddYears(-10);
+        var creation = creationDate ?? exec;
+        var code = $"ORD{Interlocked.Increment(ref _seq):D8}";
+
+        await sql.ExecuteAsync("""
+            INSERT INTO PaymentOrder.[Order]
+                (Id, Code, StatusCode, StandingOrder, CreationDate, ExecutionDate, DebtorAccountRelNr)
+            VALUES (@Id, @Code, @Status, @SO, @Creation, @Exec, @Rel);
+            """, default,
+            SqlParam.Of("@Id", id), SqlParam.Of("@Code", code),
+            SqlParam.Of("@Status", statusCode), SqlParam.Of("@SO", standingOrder),
+            SqlParam.Of("@Creation", creation), SqlParam.Of("@Exec", exec),
+            SqlParam.Of("@Rel", relationshipNumber));
+
+        var detailId = Guid.NewGuid();
+        await sql.ExecuteAsync(
+            $"INSERT INTO PaymentOrder.{detailTable} (Id, OrderId) VALUES (@Id, @OrderId);",
+            default, SqlParam.Of("@Id", detailId), SqlParam.Of("@OrderId", id));
+
+        if (standingOrder)
+        {
+            await sql.ExecuteAsync("""
+                UPDATE PaymentOrder.StandingOrder
+                   SET FirstExecutionDate = @First, LastExecutionDate = @Last
+                 WHERE OrderId = @OrderId;
+                """, default,
+                SqlParam.Of("@First", exec), SqlParam.Of("@Last", (object?)lastExecutionDate),
+                SqlParam.Of("@OrderId", id));
+        }
+
+        for (var i = 0; i < revisions; i++)
+            await AddRevisionAsync(id, code, statusCode, detailTable, detailId);
+
+        return id;
+    }
+
+    private async Task AddRevisionAsync(
+        Guid orderId, string code, string status, string detailTable, Guid detailId)
+    {
+        var historyId = Guid.NewGuid();
+        await sql.ExecuteAsync("""
+            INSERT INTO PaymentOrder.OrderHistory (Id, OrderRefId, Code, StatusCode)
+            VALUES (@Id, @OrderRefId, @Code, @Status);
+            """, default,
+            SqlParam.Of("@Id", historyId), SqlParam.Of("@OrderRefId", orderId),
+            SqlParam.Of("@Code", code), SqlParam.Of("@Status", status));
+
+        // Il doppio vincolo: lo storico di dettaglio referenzia sia OrderHistory
+        // sia il dettaglio corrente.
+        await sql.ExecuteAsync(
+            $"""
+             INSERT INTO PaymentOrder.{detailTable}History (Id, OrderHistoryId, {detailTable}RefId)
+             VALUES (@Id, @OrderHistoryId, @RefId);
+             """, default,
+            SqlParam.Of("@Id", Guid.NewGuid()),
+            SqlParam.Of("@OrderHistoryId", historyId),
+            SqlParam.Of("@RefId", detailId));
+    }
+
+    /// <summary>Storico orfano: OrderRefId NULL, caso C1.</summary>
+    public async Task<Guid> AddOrphanHistoryAsync(DateTime? updatedOn = null)
+    {
+        var id = Guid.NewGuid();
+        await sql.ExecuteAsync("""
+            INSERT INTO PaymentOrder.OrderHistory (Id, OrderRefId, Code, StatusCode, UpdatedOn)
+            VALUES (@Id, NULL, @Code, 'Executed', @UpdatedOn);
+            """, default,
+            SqlParam.Of("@Id", id), SqlParam.Of("@Code", $"ORPH{id:N}"[..20]),
+            SqlParam.Of("@UpdatedOn", updatedOn ?? DateTime.Today.AddYears(-10)));
+        return id;
+    }
+
+    /// <summary>Template di pagamento: protegge dalla cascata di Model (C5).</summary>
+    public async Task AddModelAsync(Guid orderId)
+    {
+        await sql.ExecuteAsync("""
+            INSERT INTO PaymentOrder.Model (Id, OrderId, Name, RelationshipNumber)
+            VALUES (@Id, @OrderId, 'template', 0);
+            """, default,
+            SqlParam.Of("@Id", Guid.NewGuid()), SqlParam.Of("@OrderId", orderId));
+    }
+
+    /// <summary>
+    /// Collettivo con componenti e, opzionalmente, righe respinte in validazione
+    /// (OrderId NULL): il caso che faceva fallire la coda con violazione di FK.
+    /// </summary>
+    public async Task<Guid> AddCollectiveAsync(
+        int components, int rejectedRows = 0,
+        DateTime? executionDate = null, string statusCode = "Executed",
+        string componentStatus = "Executed")
+    {
+        var collectiveId = Guid.NewGuid();
+        var groupId = Guid.NewGuid();
+
+        await sql.ExecuteAsync("""
+            INSERT INTO PaymentOrder.CollectiveOrder (Id, StatusCode, ExecutionDate)
+            VALUES (@Id, @Status, @Exec);
+            """, default,
+            SqlParam.Of("@Id", collectiveId), SqlParam.Of("@Status", statusCode),
+            SqlParam.Of("@Exec", (object?)executionDate ?? DateTime.Today.AddYears(-10)));
+
+        await sql.ExecuteAsync("""
+            INSERT INTO PaymentOrder.CollectiveOrderGroup (Id, CollectiveOrderId, Code)
+            VALUES (@Id, @CollectiveOrderId, 'G1');
+            """, default,
+            SqlParam.Of("@Id", groupId), SqlParam.Of("@CollectiveOrderId", collectiveId));
+
+        for (var i = 0; i < components; i++)
+        {
+            var orderId = await AddOrderAsync(statusCode: componentStatus, revisions: 1);
+            await sql.ExecuteAsync("""
+                INSERT INTO PaymentOrder.CollectiveOrderGroupOrder
+                    (Id, CollectiveOrderGroupId, OrderId, OrderType)
+                VALUES (@Id, @GroupId, @OrderId, 'BankTransfer');
+                """, default,
+                SqlParam.Of("@Id", Guid.NewGuid()), SqlParam.Of("@GroupId", groupId),
+                SqlParam.Of("@OrderId", orderId));
+        }
+
+        for (var i = 0; i < rejectedRows; i++)
+        {
+            await sql.ExecuteAsync("""
+                INSERT INTO PaymentOrder.CollectiveOrderGroupOrder
+                    (Id, CollectiveOrderGroupId, OrderId, ValidationErrors)
+                VALUES (@Id, @GroupId, NULL, 'IBAN non valido');
+                """, default,
+                SqlParam.Of("@Id", Guid.NewGuid()), SqlParam.Of("@GroupId", groupId));
+        }
+
+        return collectiveId;
+    }
+
+    public Task<long> CountAsync(string table) =>
+        sql.ScalarAsync<long>($"SELECT COUNT_BIG(*) FROM PaymentOrder.{table};", default)!;
+
+    /// <summary>
+    /// Righe rimaste senza il proprio padre. Deve essere sempre zero: e'
+    /// l'invariante che l'intera topologia esiste per garantire.
+    /// </summary>
+    public async Task<long> CountOrphanRowsAsync()
+    {
+        const string q = """
+            SELECT
+              (SELECT COUNT_BIG(*) FROM PaymentOrder.BankTransfer d
+                 WHERE NOT EXISTS (SELECT 1 FROM PaymentOrder.[Order] o WHERE o.Id = d.OrderId))
+            + (SELECT COUNT_BIG(*) FROM PaymentOrder.OrderHistory h
+                 WHERE h.OrderRefId IS NOT NULL
+                   AND NOT EXISTS (SELECT 1 FROM PaymentOrder.[Order] o WHERE o.Id = h.OrderRefId))
+            + (SELECT COUNT_BIG(*) FROM PaymentOrder.BankTransferHistory bh
+                 WHERE NOT EXISTS (SELECT 1 FROM PaymentOrder.OrderHistory h WHERE h.Id = bh.OrderHistoryId));
+            """;
+        return await sql.ScalarAsync<long>(q, default);
+    }
+
+    public Task SetStatusAsync(Guid orderId, string statusCode) =>
+        sql.ExecuteAsync("UPDATE PaymentOrder.[Order] SET StatusCode = @S WHERE Id = @Id;",
+            default, SqlParam.Of("@S", statusCode), SqlParam.Of("@Id", orderId));
+}
