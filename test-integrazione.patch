+using Microsoft.Extensions.DependencyInjection;
+using OSM.PaymentOrder.Purge.Data;
+using OSM.PaymentOrder.Purge.Domain;
+using OSM.PaymentOrder.Purge.Engine;
+
+namespace OSM.PaymentOrder.Purge.Tests;
+
+/// <summary>
+/// I cinque invarianti che l'analisi identifica come critici. Ognuno
+/// corrisponde a un difetto realmente comparso durante lo sviluppo: sono test
+/// di regressione, non esercizi teorici.
+/// </summary>
+[Collection("PurgeDatabase")]
+public sealed class RetentionInvariantsTests(PurgeDatabaseFixture db)
+{
+    private SeedBuilder Seed => new(db.Sql);
+
+    private async Task<PurgeRun> RunAsync(RetentionStrategy strategy)
+    {
+        var runId = await db.Store.CreateAsync(
+            strategy, db.Options, DateTimeOffset.Now, default);
+
+        await db.Orchestrator.RunAsync(runId, default);
+        return await db.Store.LoadAsync(runId, default);
+    }
+
+    /// <summary>
+    /// Il run deve chiudersi in Completed.
+    ///
+    /// ExecutingPhase restituiva Next(RunPhase.Completed), che lascia
+    /// Stop = false: l'orchestratore proseguiva il ciclo, non trovava un
+    /// handler per Completed e marcava Failed ogni run riuscito.
+    /// </summary>
+    [Fact]
+    public async Task Run_riuscito_termina_in_Completed()
+    {
+        await Seed.AddOrderAsync(revisions: 2);
+        await Seed.AddOrderAsync(revisions: 0);
+
+        var run = await RunAsync(RetentionStrategy.Terminated);
+
+        Assert.Equal(RunPhase.Completed, run.Phase);
+    }
+
+    /// <summary>Nessuna riga deve sopravvivere al proprio padre.</summary>
+    [Theory]
+    [InlineData("BankTransfer")]
+    [InlineData("AccountTransfer")]
+    [InlineData("ForeignBankTransfer")]
+    [InlineData("QRBill")]
+    [InlineData("IpQRBill")]
+    public async Task Cancellazione_non_lascia_orfani(string detailTable)
+    {
+        for (var i = 0; i < 5; i++)
+            await Seed.AddOrderAsync(revisions: 3, detailTable: detailTable);
+
+        await RunAsync(RetentionStrategy.Terminated);
+
+        Assert.Equal(0, await Seed.CountAsync("[Order]"));
+        Assert.Equal(0, await Seed.CountAsync("OrderHistory"));
+        Assert.Equal(0, await Seed.CountAsync(detailTable));
+        Assert.Equal(0, await Seed.CountAsync($"{detailTable}History"));
+        Assert.Equal(0, await Seed.CountOrphanRowsAsync());
+    }
+
+    /// <summary>
+    /// Un ordine referenziato da Model non deve entrare fra i candidati:
+    /// Model.OrderId e' in CASCADE e la cancellazione distruggerebbe il
+    /// template senza che nulla lo segnali (caso C5).
+    /// </summary>
+    [Fact]
+    public async Task Ordine_referenziato_da_Model_non_viene_cancellato()
+    {
+        var protetto = await Seed.AddOrderAsync(revisions: 1);
+        await Seed.AddModelAsync(protetto);
+        await Seed.AddOrderAsync(revisions: 1);
+
+        await RunAsync(RetentionStrategy.Terminated);
+
+        Assert.Equal(1, await Seed.CountAsync("[Order]"));
+        Assert.Equal(1, await Seed.CountAsync("Model"));
+    }
+
+    /// <summary>
+    /// Un piano ricorrente senza LastExecutionDate e' attivo e non e'
+    /// eleggibile, per quanto vecchia sia la testata. E' il rischio funzionale
+    /// piu' grave dell'intera soluzione.
+    /// </summary>
+    [Fact]
+    public async Task Piano_ricorrente_attivo_non_viene_cancellato()
+    {
+        await Seed.AddOrderAsync(standingOrder: true, lastExecutionDate: null);
+        await Seed.AddOrderAsync(standingOrder: true,
+            lastExecutionDate: DateTime.Today.AddYears(-8));
+
+        await RunAsync(RetentionStrategy.StandingOrders);
+
+        Assert.Equal(1, await Seed.CountAsync("[Order]"));
+        Assert.Equal(1, await Seed.CountAsync("StandingOrder"));
+    }
+
+    /// <summary>
+    /// Un collettivo con righe respinte in validazione: quelle righe hanno
+    /// OrderId NULL, non entrano nello staging e il gruppo 3 non le tocca.
+    /// Senza gli statement residui la DELETE su CollectiveOrderGroup fallisce
+    /// con violazione di foreign key (casi C3 e C12).
+    /// </summary>
+    [Fact]
+    public async Task Collettivo_con_righe_scartate_viene_cancellato_integralmente()
+    {
+        await Seed.AddCollectiveAsync(components: 4, rejectedRows: 2);
+
+        var run = await RunAsync(RetentionStrategy.Collective);
+
+        Assert.Equal(RunPhase.Completed, run.Phase);
+        Assert.Equal(0, await Seed.CountAsync("CollectiveOrder"));
+        Assert.Equal(0, await Seed.CountAsync("CollectiveOrderGroup"));
+        Assert.Equal(0, await Seed.CountAsync("CollectiveOrderGroupOrder"));
+        Assert.Equal(0, await Seed.CountAsync("[Order]"));
+        Assert.Equal(0, await Seed.CountOrphanRowsAsync());
+    }
+
+    /// <summary>
+    /// Se un componente non e' eleggibile, l'intero collettivo viene rinviato:
+    /// TotalAmount e TransactionCount sono aggregati denormalizzati e
+    /// cancellare parzialmente li renderebbe incoerenti (caso C10).
+    /// </summary>
+    [Fact]
+    public async Task Collettivo_con_componente_non_eleggibile_resta_intatto()
+    {
+        await Seed.AddCollectiveAsync(components: 3, componentStatus: "Processing");
+
+        await RunAsync(RetentionStrategy.Collective);
+
+        Assert.Equal(1, await Seed.CountAsync("CollectiveOrder"));
+        Assert.Equal(3, await Seed.CountAsync("[Order]"));
+    }
+
+    /// <summary>Storici orfani: nessun aggregato da preservare, cancellazione diretta.</summary>
+    [Fact]
+    public async Task Storici_orfani_vengono_sfoltiti()
+    {
+        for (var i = 0; i < 3; i++) await Seed.AddOrphanHistoryAsync();
+        await Seed.AddOrderAsync(revisions: 2);   // storici NON orfani
+
+        await RunAsync(RetentionStrategy.OrphanHistory);
+
+        Assert.Equal(2, await Seed.CountAsync("OrderHistory"));
+        Assert.Equal(1, await Seed.CountAsync("[Order]"));
+    }
+
+    /// <summary>Il piano rispetta entrambi i tetti, salvo gli aggregati oversized.</summary>
+    [Fact]
+    public async Task Il_piano_rispetta_entrambi_i_tetti()
+    {
+        for (var i = 0; i < 40; i++) await Seed.AddOrderAsync(revisions: 2);
+
+        var runId = await db.Store.CreateAsync(
+            RetentionStrategy.Terminated, db.Options, DateTimeOffset.Now, default);
+        await db.Orchestrator.RunAsync(runId, default);
+
+        var slices = await db.Sql.QueryAsync("""
+            SELECT OrderCount, EstimatedRowCount, IsOversized
+            FROM Purge.RunBatchProgress WHERE RunId = @RunId;
+            """, r => new { Orders = r.GetInt32(0), Rows = r.GetInt32(1), Oversized = r.GetBoolean(2) },
+            default, SqlParam.Of("@RunId", runId));
+
+        Assert.NotEmpty(slices);
+        Assert.All(slices, s =>
+        {
+            if (s.Oversized) return;
+            Assert.True(s.Orders <= db.Options.MaxOrdersPerBatch,
+                $"slice con {s.Orders} ordini, tetto {db.Options.MaxOrdersPerBatch}");
+            Assert.True(s.Rows <= db.Options.MaxRowsPerBatch,
+                $"slice con {s.Rows} righe, tetto {db.Options.MaxRowsPerBatch}");
+        });
+
+        var senzaBatch = await db.Sql.ScalarAsync<long>("""
+            SELECT COUNT_BIG(*) FROM Purge.RunCandidateOrder
+            WHERE RunId = @RunId AND BatchNo IS NULL;
+            """, default, SqlParam.Of("@RunId", runId));
+
+        Assert.Equal(0, senzaBatch);
+    }
+
+    /// <summary>
+    /// La verifica dello schema deve passare: se fallisce, il file
+    /// 010_test_schema.sql ha smesso di rispecchiare PurgeTopology.
+    /// </summary>
+    [Fact]
+    public async Task Lo_schema_di_test_copre_la_topologia()
+    {
+        var missing = await db.Services.GetRequiredService<SchemaVerifier>()
+                                       .FindMissingAsync(default);
+        Assert.Empty(missing);
+    }
+}
